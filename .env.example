# Environment Configuration for Aria Chatbot

# API Keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Optional, for GPT models
SERPAPI_KEY=your_serpapi_key_here  # Optional, for web search

# LLM Configuration
LLM_PROVIDER=google  # Options: google, openai, ollama
LLM_MODEL=gemini-pro  # Options: gemini-pro, gpt-4, gpt-3.5-turbo, llama3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2  # Sentence transformer model
EMBEDDING_DIMENSION=384

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Leave empty for local instance
QDRANT_COLLECTION_NAME=aria_knowledge
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=30
QDRANT_MEMORY_COLLECTION=aria_conversations
# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_HOST=localhost
FRONTEND_PORT=8501

# Agent Configuration
RETRIEVAL_TOP_K=5  # Number of documents to retrieve
WEB_SCRAPING_ENABLED=true
WEB_SCRAPING_MAX_RESULTS=3
MEMORY_ENABLED=true
EVALUATION_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/aria.log

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
MAX_CONVERSATION_HISTORY=50

# Performance
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=10

# Security (for production)
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
